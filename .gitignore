# ---- MNC .gitignore ----
# Keep the repo focused on source, skip derived, regenerated, and local-only stuff.

# npm dependencies (reinstallable from package.json)
node_modules/

# Capacitor's sync target, regenerated from the web source on every build
www/

# Android build artifacts, regenerated
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/release/
*.apk
*.aab

# Old deploy zips + scratch files, keep on disk, don't version
archive/

# macOS / Windows junk
.DS_Store
Thumbs.db

# Editor / IDE local settings
.vscode/
.idea/
*.swp
*.swo

# Env files, if you ever add any, don't ship secrets to git
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Android signing, NEVER commit. Keystore = private signing key. Loss = compromised app identity.
*.jks
*.keystore
upload_certificate.pem
upload_certificate.crt
*.p8
*.p12

# iOS code-signing intermediates, never commit
*.csr
*.key
*.cer
*.p12
*.mobileprovision

# All iOS code-signing artifacts (CSRs, keys, certs, profiles, decoded plists)
signing/

# Local sentinel for sync.sh's auto-build-bump (per-machine, not shared)
.last-build-bump
/og17-launch
/og17-launch
/og17-launch
OGeml.html
og17-launch/send-to-original-founders.html
rescue/

# ── Repo-weight cleanup, 2026-07-20 ─────────────────────────────────────
# Retired Netlify bundles. The GH Pages Action publishes deploy/ghpages/
# ONLY, so these two are dead weight (~40MB of duplicated assets). Kept on
# disk as a rollback option, just not versioned.
deploy/marketing/
deploy/app/

# Derived campaign bundle, regenerated from campaign-assets/countdown/.
# 19MB per copy and nothing links to it, so it doesn't belong in history.
campaign-assets/*.zip
deploy/ghpages/campaign-assets/*.zip

# Local, machine-specific dev-server config (contains absolute paths)
.claude/

# Local archive of old 2.0 campaign material (README, archive-2.0 mp4s, brand
# files). 42MB, not deployed (sync.sh never copies this dir), kept on disk.
# Root-anchored so marketing.html / marketing-v3.html stay tracked.
/marketing/

# Temp design preview, not part of the app
_preview-mauve.html

# Throwaway staging bundle for PWA testing (drag to Netlify Drop)
deploy/staging-v3/

# Python bytecode from deploy/ scripts
__pycache__/
*.pyc
